---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DisplaySettings from '../components/DisplaySettings.astro';
import { review, subtitle } from '../lib/content';
import { withBase } from '../lib/url';
import displaySettings from '../scripts/display-settings.js?raw';
import manropeLatin from '../assets/fonts/manrope-latin.woff2?url';
import '../styles/global.css';
interface Props { title: string; description?: string; current?: string; searchable?: boolean; }
const { title, description = subtitle, current = '', searchable = true } = Astro.props;
const pageTitle = `${title} · MEB France`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={displaySettings}></script>
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {review && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MEB France" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href={withBase(`${Astro.url.pathname}#main`)}>Aller au contenu principal</a>
    <Header current={current} />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? true : undefined}>
      {review && <p class="review-notice" data-pagefind-ignore><strong>Version de travail.</strong> Ce site n’est pas publié. Textes et présentation à valider.</p>}
      <slot />
    </main>
    <Footer />
    <DisplaySettings />
  </body>
</html>
